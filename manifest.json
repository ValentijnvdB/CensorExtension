{
  "manifest_version": 2,
  "name": "Image Censor Extension",
  "version": "1.0.0",
  "description": "Replaces page images with censored versions.",

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "state.js",
        "dom-utils.js",
        "filters.js",
        "gifs.js",
        "videos.js",
        "load-behavior.js",
        "pipeline.js",
        "content.js",
        "settings_cache.js",
        "settings_reader.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    "filters.json",
    "assets/removed.gif",
    "assets/loading.png"
  ],

  "browser_action": {
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
    },
    "default_title": "Image Censor",
    "default_popup": "popup/popup.html"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "my@censor_extension"
    }
  }
}